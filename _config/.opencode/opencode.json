{
  "$schema": "https://opencode.ai/config.json",
  "model": "nvidia/nvidia/llama-3.1-nemotron-ultra-253b-v1",
  "small_model": "nvidia/nvidia/llama-3.1-nemotron-nano-8b-v1",
  "instructions": [
    "C:\\02_QUILLAN\\_config\\.opencode\\AGENTS.md",
    "C:\\02_QUILLAN\\system prompts\\Quillan-Samurai.md"
  ],
  "shell": "pwsh",
  "logLevel": "WARN",
  "share": "manual",
  "autoupdate": "notify",
  "snapshot": false,
  "experimental": {
    "disable_paste_summary": false,
    "batch_tool": true,
    "openTelemetry": false,
    "primary_tools": ["edit"],
    "continue_loop_on_deny": false,
    "mcp_timeout": 15000
  },
  "tool_output": {
    "max_lines": 5000,
    "max_bytes": 50000
  },
  "compaction": {
    "auto": true,
    "prune": true,
    "tail_turns": 20
  },
  "permission": {
    "edit": "allow",
    "bash": {
      "git *": "allow",
      "*": "ask"
    },
    "question": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "todowrite": "allow"
  },
  "provider": {
    "nvidia": {
      "options": {
        "baseURL": "https://integrate.api.nvidia.com/v1",
        "apiKey": "$NVIDIA_API_KEY"
      }
    }
  }
}
